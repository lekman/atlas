{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "3",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**", "*.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "outputs": [],
      "cache": false
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "outputLogs": "new-only"
    }
  }
}
