{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "ai-toolkit": {
      "source": {
        "source": "github",
        "repo": "lekman/ai-toolkit"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "git@ai-toolkit": true,
    "tone@ai-toolkit": true,
    "dependabot@ai-toolkit": true
  },
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git -c core.hooksPath=*)",
      "Bash(git config core.hooksPath:*)",
      "Read(scripts/client-terms.txt)"
    ],
    "ask": [
      "Edit(.trunk/trunk.yaml)",
      "Edit(.husky/**)",
      "Edit(scripts/check-no-client-content.sh)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-verify-guard.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-tripwire.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
