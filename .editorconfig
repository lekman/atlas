# shfmt reads this file for shell formatting. Without it shfmt defaults to
# tabs, which would rewrite every shell script and disagree with prettier and
# the rest of the repository.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash}]
# shfmt-specific: keep the binary-operator line breaks and switch-case
# indentation that the existing scripts already use.
indent_style = space
indent_size = 2
switch_case_indent = true

[*.md]
# Trailing double-space is a hard line break in markdown.
trim_trailing_whitespace = false
