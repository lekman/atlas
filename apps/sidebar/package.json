{
  "name": "@atlas/sidebar",
  "version": "0.0.0",
  "description": "The Atlas sidebar: one self-contained HTML file for the claude.ai artifact, the phone and the VS Code view",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "harness": "bun scripts/harness.ts",
    "check": "SIDEBAR_CONFIG=sidebar.config.example.json vite build && bun scripts/harness.ts"
  },
  "dependencies": {
    "@atlas/runtime": "workspace:*",
    "@atlas/ui": "workspace:*",
    "@atlas/worlds": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0",
    "vite": "^8.3.5",
    "playwright": "^1.64.1"
  }
}
